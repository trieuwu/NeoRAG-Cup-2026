# Cấu hình đóng băng cho Private Test (nạp bởi scripts/run_private.ps1 / .sh).
# Chỉ chứa biến RAG_* (KHÔNG chứa key; key nằm trong .env). Giá trị dưới đây = bản E7 (Public 88.95),
# ghi tường minh để không phụ thuộc giá trị mặc định trong code.
RAG_REWRITE=1
RAG_REWRITE_PROMPT=v3
RAG_PROMPT=v5
RAG_CONTEXT_K=5
RAG_DYNAMIC_FEW_SHOT=0
RAG_N_RETRIEVED=10
RAG_USE_BM25=1
RAG_USE_DENSE=1
RAG_CLUB_BOOST=1.0
RAG_USE_RERANK=1
RAG_RERANK_BACKEND=llm
RAG_RERANK_DEPTH=20
RAG_RERANK_MAX=8
RAG_W_RERANK=4.0
RAG_DIVERSIFY_CLUBS=1
RAG_USE_ANCHORS=0
